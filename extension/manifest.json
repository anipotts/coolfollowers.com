{
  "manifest_version": 3,
  "name": "coolfollowers",
  "description": "See which Instagram followers are actually cool. Your data stays in Chrome.",
  "version": "1.0.0",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://coolfollowers.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coolfollowers.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "coolfollowers"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
